{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenStage Studio",
  "version": "0.1.0",
  "identifier": "org.openstage.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../studio-helper/target/release/studio-helper.exe": "studio-helper.exe",
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt",
      "../third-party/onnxruntime/LICENSE": "third-party/onnxruntime/LICENSE.txt",
      "../third-party/onnxruntime/ThirdPartyNotices.txt": "third-party/onnxruntime/ThirdPartyNotices.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" }
    }
  }
}
